/** @var Maho_PageCache_Block_Adminhtml_Dashboard_Tabs $this */
?>
<?php if (!empty($tabs)): ?>
<div class="pc-tabs-bar">
    <div id="<?= $this->getId() ?>" class="tabs-horiz d-tabs d-tabs-border" role="tablist">
    <?php foreach ($tabs as $_tab): ?>
        <a href="<?= $this->getTabUrl($_tab) ?>" id="<?= $this->getTabId($_tab) ?>" name="<?= $this->getTabId($_tab, false) ?>" title="<?= $this->getTabTitle($_tab) ?>" role="tab" aria-selected="false" class="tab-item-link d-tab <?= $this->getTabClass($_tab) ?><?php if (preg_match('/\s?ajax\s?/', $this->getTabClass($_tab))) {?> notloaded<?php }?>">
            <span><?= $this->getTabLabel($_tab) ?><span class="changed" title="<?= $this->quoteEscape($this->__('The information in this tab has been changed.')) ?>"><?= $this->getIconSvg('device-floppy') ?></span><span class="error" title="<?= $this->quoteEscape($this->__('This tab contains invalid data. Please solve the problem before saving.')) ?>"><?= $this->getIconSvg('alert-triangle') ?></span></span>
        </a>
    <?php endforeach ?>
    </div>
    <?= $this->getFilterHtml() ?>
</div>
<?php foreach ($tabs as $_tab): ?>
<div id="<?= $this->getTabId($_tab) ?>_content" style="display:none"><?= $this->getTabContent($_tab) ?></div>
<?php endforeach ?>
<script>

    <?= $this->getId() ?>JsTabs = new varienTabs('<?= $this->getId() ?>', '<?= $this->getDestElementId() ?>', '<?= $this->getActiveTabId() ?>', <?= $this->getAllShadowTabs() ?>);
</script>
<?php endif ?>
