$trafficEvents = (int) ($summary['hit'] ?? 0) + (int) ($summary['miss'] ?? 0) + (int) ($summary['bypass'] ?? 0);
$hitRate = $trafficEvents > 0 ? number_format((float) ($summary['hit_rate'] ?? 0), 1) . '%' : $this->__('n/a');
$phpDuration = $summary['avg_duration_ms'] === null
    ? $this->__('n/a')
    : number_format((float) $summary['avg_duration_ms'], 1) . ' ms';
$lastRollup = $this->getLastRollupBucket();
?>
