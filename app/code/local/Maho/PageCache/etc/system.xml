<?xml version="1.0"?>
<config>
    <sections>
        <page_cache translate="label">
            <label>Page Cache</label>
            <tab>general</tab>
            <frontend_type>text</frontend_type>
            <sort_order>900</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <general translate="label">
                    <label>General</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <expanded>1</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable Page Cache</label>
                            <comment>Only anonymous GET requests on the configured routes are affected.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                        <mode translate="label comment">
                            <label>Mode</label>
                            <comment>Proxy stores HTML in a reverse proxy or CDN. Revalidating asks the proxy to revalidate every request with ETag or Last-Modified. Local stores full page HTML in Maho's cache and skips layout generation on a hit.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>page_cache/system_config_source_mode</source_model>
                            <backend_model>page_cache/system_config_backend_mode</backend_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </mode>
                        <ttl translate="label comment">
                            <label>TTL (seconds)</label>
                            <comment>Lifetime of the cache metadata and the proxy cache entries.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </ttl>
                        <html_max_size translate="label comment">
                            <label>Local HTML Size Limit (bytes)</label>
                            <comment>A larger page bypasses the local cache. Default is 2 MB.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>35</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </html_max_size>
                        <cacheable_routes translate="label comment">
                            <label>Cacheable Routes</label>
                            <comment>One full action name per line, for example catalog_product_view.</comment>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </cacheable_routes>
                        <session_skip_routes translate="label comment">
                            <label>Session Skip Routes</label>
                            <comment>One full action name per line. Requests without a Maho session cookie skip session start on these routes.</comment>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </session_skip_routes>
                        <allowed_params translate="label comment">
                            <label>Allowed Query Parameters</label>
                            <comment>Comma-separated. A request with any other query parameter bypasses the cache.</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </allowed_params>
                        <filter_path_marker translate="label comment">
                            <label>Filter Path Segment</label>
                            <comment>URL segment that marks a layered-navigation page, for example shop for /shoes/shop/nike.html. Leave empty to disable the filter depth check.</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>62</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </filter_path_marker>
                        <max_filter_depth translate="label comment">
                            <label>Max Filter Depth</label>
                            <comment>Deepest layered-navigation combination still cached. Each extra segment and each -- joined value counts as one. Default is 2.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>64</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </max_filter_depth>
                        <max_path_segments translate="label comment">
                            <label>Max Path Segments</label>
                            <comment>A deeper path bypasses the cache. This caps crawler-generated URL variants. Default is 8.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>66</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </max_path_segments>
                        <respect_no_cache translate="label comment">
                            <label>Respect no-cache Requests</label>
                            <comment>When enabled, a request with Cache-Control: no-cache bypasses the cache.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </respect_no_cache>
                        <stock_pending_warn_age translate="label comment">
                            <label>Stock Pending Warning (seconds)</label>
                            <comment>The hourly cron logs a warning when the oldest pending stock invalidation is older than this. 0 disables the warning.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>75</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </stock_pending_warn_age>
                        <debug_headers translate="label comment">
                            <label>Debug Headers</label>
                            <comment>Output X-Maho-Cache-Tags, X-Maho-Cache-Version and detailed bypass reasons.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>80</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </debug_headers>
                    </fields>
                </general>
                <local translate="label">
                    <label>Local Cache</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>16</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <compression_enabled translate="label comment">
                            <label>Compress Local HTML</label>
                            <comment>Store gzip HTML when it is smaller than plain. The HTML size limit is in General.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </compression_enabled>
                        <compression_min_bytes translate="label comment">
                            <label>Compression Minimum (bytes)</label>
                            <comment>Pages smaller than this stay plain. Default is 4096.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </compression_min_bytes>
                        <compression_level translate="label comment">
                            <label>Compression Level</label>
                            <comment>gzip level from 1 to 9. Default is 6.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </compression_level>
                    </fields>
                </local>
                <proxy translate="label">
                    <label>Proxy Context</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>15</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <context_mode translate="label comment">
                            <label>Proxy Context Mode</label>
                            <comment>Cookie works when the proxy honors Vary: Cookie. Default context only is a fallback for URL-only proxies; requests that switch store with a cookie then bypass.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>page_cache/system_config_source_proxy_context</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </context_mode>
                    </fields>
                </proxy>
                <purge translate="label">
                    <label>Purge Outbox</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>18</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <max_attempts translate="label comment">
                            <label>Max Attempts</label>
                            <comment>How many times a purge hand-off is tried before the row is marked failed.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </max_attempts>
                        <retry_delay translate="label comment">
                            <label>Retry Delay (seconds)</label>
                            <comment>Base delay for exponential backoff. The delay doubles after each failed attempt.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </retry_delay>
                        <stale_after translate="label comment">
                            <label>Stale After (seconds)</label>
                            <comment>Log a warning when the oldest pending purge is older than this. Default is 3600.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </stale_after>
                        <retention_days translate="label comment">
                            <label>Retention (days)</label>
                            <comment>How long delivered and failed outbox rows are kept for status. Default is 7.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </retention_days>
                        <lease_seconds translate="label comment">
                            <label>Processing Lease (seconds)</label>
                            <comment>A claimed row returns to pending when its lease expires. Default is 300.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </lease_seconds>
                    </fields>
                </purge>
                <dynamic translate="label">
                    <label>Dynamic Blocks</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <injection translate="label comment">
                            <label>Injection Method</label>
                            <comment>Ajax works without a reverse proxy. ESI requires a proxy that resolves esi:include; local mode always uses Ajax.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>page_cache/system_config_source_injection</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </injection>
                        <ttl translate="label comment">
                            <label>Dynamic Block TTL (seconds)</label>
                            <comment>0 disables dynamic block caching. Only blocks explicitly marked cacheable use this value.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </ttl>
                        <server_side translate="label comment">
                            <label>Render Server-side Blocks on Local Hits</label>
                            <comment>Rebuild explicitly marked leaf blocks during local mode hits. Proxy and static hits keep the anonymous fallback.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>15</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </server_side>
                        <server_types translate="label comment">
                            <label>Server-side Block Types</label>
                            <comment>Comma-separated block type aliases allowed to rebuild, for example core/template. Empty disables server-side rendering.</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>16</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </server_types>
                        <rate_limit translate="label comment">
                            <label>Dynamic Request Limit</label>
                            <comment>Maximum dynamic block requests per client in the window. 0 disables the limit.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>25</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </rate_limit>
                        <rate_limit_window translate="label comment">
                            <label>Dynamic Request Window (seconds)</label>
                            <comment>Window for the dynamic request limit. Default is 60 seconds.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-greater-than-zero</validate>
                            <sort_order>26</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </rate_limit_window>
                    </fields>
                </dynamic>
                <warmup translate="label">
                    <label>Warmup</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>30</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable Scheduled Warmup</label>
                            <comment>Queues invalidated pages and warms them from cron. Default is off.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>5</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                        <concurrency translate="label comment">
                            <label>Concurrent Requests</label>
                            <comment>Default concurrency for page-cache:warm and the warmup queue.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </concurrency>
                        <batch_size translate="label comment">
                            <label>Queue Batch Size</label>
                            <comment>Maximum URLs processed by one cron run. Default is 50.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </batch_size>
                        <delay_ms translate="label comment">
                            <label>Delay Between Request Starts (ms)</label>
                            <comment>Minimum interval between starting two warmup requests. Default is 500. Set 0 to disable.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </delay_ms>
                        <max_attempts translate="label comment">
                            <label>Maximum Attempts</label>
                            <comment>A URL leaves the queue after this many failed attempts. Default is 3.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </max_attempts>
                        <retry_delay translate="label comment">
                            <label>Retry Delay (seconds)</label>
                            <comment>Base delay before a retry, multiplied by the attempt number. Default is 300.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </retry_delay>
                        <queue_limit translate="label comment">
                            <label>Queue Limit</label>
                            <comment>Maximum queued URLs. The oldest entries are dropped when the limit is reached. Default is 10000.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </queue_limit>
                        <auth_user translate="label comment">
                            <label>Basic Auth User</label>
                            <comment>Optional HTTP basic auth user for warmup requests. Use only over HTTPS.</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </auth_user>
                        <allowed_hosts translate="label comment">
                            <label>Additional Allowed Origins</label>
                            <comment>One origin per line, for example https://www.example.com. The scheme, host and port must match exactly. Use this for store alias domains that warmup may request.</comment>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>75</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </allowed_hosts>
                        <auth_password translate="label comment">
                            <label>Basic Auth Password</label>
                            <comment>Stored encrypted. Use only over HTTPS.</comment>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <sort_order>80</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </auth_password>
                    </fields>
                </warmup>
                <audit translate="label">
                    <label>Invalidation Audit</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>52</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable Invalidation Audit</label>
                            <comment>Record tag and full invalidations in the page cache audit table. Independent from request statistics.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                        <retention_days translate="label comment">
                            <label>Retention (days)</label>
                            <comment>How long invalidation records are kept. Default is 30.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </retention_days>
                        <sample_tags translate="label comment">
                            <label>Sample Tags</label>
                            <comment>Maximum number of tag names stored per record. The total count is always stored. Default is 20.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </sample_tags>
                    </fields>
                </audit>
                <static translate="label">
                    <label>Static Export</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>40</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable Static HTML Export</label>
                            <comment>Writes anonymous default pages to var/page-cache/static for nginx or Caddy. Requires web server configuration, a deny rule for the cache directory, and the cleanup cron. The first version supports one node.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                    </fields>
                </static>
                <stats translate="label">
                    <label>Statistics</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>50</sort_order>
                    <expanded>0</expanded>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable Statistics</label>
                            <comment>Records PHP-side page cache events in the database. Static, proxy and CDN hits do not run PHP and are not counted.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                        <mode translate="label comment">
                            <label>Statistics Mode</label>
                            <comment>Full records every request event. Sampled records a percentage of requests. Purge, flush and warmup events are always recorded.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>page_cache/system_config_source_statsMode</source_model>
                            <sort_order>15</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </mode>
                        <sample_rate translate="label comment">
                            <label>Sample Rate</label>
                            <comment>Fraction from 0 to 1. For example 0.05 records about 5% of request events when mode is Sampled.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number</validate>
                            <sort_order>17</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </sample_rate>
                        <raw_retention_days translate="label comment">
                            <label>Raw Event Retention (days)</label>
                            <comment>How long individual events are kept before rollup cleanup. Default is 30.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </raw_retention_days>
                        <rollup_retention_days translate="label comment">
                            <label>Hourly Rollup Retention (days)</label>
                            <comment>How long hourly aggregates are kept. Default is 365.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </rollup_retention_days>
                        <max_duration_ms translate="label comment">
                            <label>Maximum Recorded Duration (ms)</label>
                            <comment>Events slower than this are still counted, but their duration is capped. Default is 60000.</comment>
                            <frontend_type>text</frontend_type>
                            <validate>validate-number validate-greater-than-zero</validate>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </max_duration_ms>
                    </fields>
                </stats>
            </groups>
        </page_cache>
    </sections>
</config>
