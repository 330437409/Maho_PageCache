<?xml version="1.0"?>
<config>
    <modules>
        <Maho_PageCache>
            <version>0.5.0</version>
        </Maho_PageCache>
    </modules>
    <global>
        <helpers>
            <page_cache>
                <class>Maho_PageCache_Helper</class>
            </page_cache>
        </helpers>
        <models>
            <page_cache>
                <class>Maho_PageCache_Model</class>
                <resourceModel>page_cache_resource</resourceModel>
            </page_cache>
            <page_cache_resource>
                <class>Maho_PageCache_Model_Resource</class>
                <entities>
                    <stat>
                        <table>page_cache_stat</table>
                    </stat>
                    <stat_hourly>
                        <table>page_cache_stat_hourly</table>
                    </stat_hourly>
                    <warmup_queue>
                        <table>page_cache_warmup_queue</table>
                    </warmup_queue>
                </entities>
            </page_cache_resource>
        </models>
        <blocks>
            <page_cache>
                <class>Maho_PageCache_Block</class>
            </page_cache>
        </blocks>
        <services>
            <page_cache>
                <class>Maho_PageCache_Service</class>
            </page_cache>
        </services>
        <cache>
            <types>
                <page_cache>
                    <label>Page Cache</label>
                    <description>HTTP page cache metadata, tag index and purge queue.</description>
                    <tags>PAGE_CACHE</tags>
                </page_cache>
            </types>
        </cache>
    </global>
    <default>
        <page_cache>
            <general>
                <enabled>0</enabled>
                <mode>revalidating</mode>
                <ttl>3600</ttl>
                <html_max_size>2097152</html_max_size>
                <cacheable_routes><![CDATA[cms_index_index
cms_page_view
catalog_category_view
catalog_product_view]]></cacheable_routes>
                <session_skip_routes><![CDATA[cms_index_index
cms_page_view
catalog_category_view
catalog_product_view]]></session_skip_routes>
                <allowed_params>p,limit,order,dir,mode</allowed_params>
                <filter_path_marker></filter_path_marker>
                <max_filter_depth>2</max_filter_depth>
                <max_path_segments>8</max_path_segments>
                <respect_no_cache>1</respect_no_cache>
                <debug_headers>0</debug_headers>
            </general>
            <dynamic>
                <injection>ajax</injection>
                <ttl>0</ttl>
                <server_side>0</server_side>
                <server_types></server_types>
            </dynamic>
            <warmup>
                <enabled>0</enabled>
                <concurrency>4</concurrency>
                <batch_size>50</batch_size>
                <delay_ms>500</delay_ms>
                <max_attempts>3</max_attempts>
                <retry_delay>300</retry_delay>
                <queue_limit>10000</queue_limit>
                <auth_user></auth_user>
                <auth_password></auth_password>
            </warmup>
            <static>
                <enabled>0</enabled>
            </static>
            <stats>
                <enabled>0</enabled>
                <raw_retention_days>30</raw_retention_days>
                <rollup_retention_days>365</rollup_retention_days>
                <max_duration_ms>60000</max_duration_ms>
            </stats>
        </page_cache>
    </default>
</config>
