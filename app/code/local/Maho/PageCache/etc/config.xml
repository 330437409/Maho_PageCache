<?xml version="1.0"?>
<config>
    <modules>
        <Maho_PageCache>
            <version>0.9.0</version>
        </Maho_PageCache>
    </modules>
    <global>
        <helpers>
            <page_cache>
                <class>Maho_PageCache_Helper</class>
            </page_cache>
        </helpers>
        <models>
            <page_cache>
                <class>Maho_PageCache_Model</class>
                <resourceModel>page_cache_resource</resourceModel>
            </page_cache>
            <page_cache_resource>
                <class>Maho_PageCache_Model_Resource</class>
                <entities>
                    <stat>
                        <table>page_cache_stat</table>
                    </stat>
                    <stat_hourly>
                        <table>page_cache_stat_hourly</table>
                    </stat_hourly>
                    <warmup_queue>
                        <table>page_cache_warmup_queue</table>
                    </warmup_queue>
                    <purge_outbox>
                        <table>page_cache_purge_outbox</table>
                    </purge_outbox>
                    <invalidation_log>
                        <table>page_cache_invalidation_log</table>
                    </invalidation_log>
                    <url>
                        <table>page_cache_url</table>
                    </url>
                    <url_context>
                        <table>page_cache_url_context</table>
                    </url_context>
                    <url_context_tag>
                        <table>page_cache_url_context_tag</table>
                    </url_context_tag>
                    <static_file>
                        <table>page_cache_static_file</table>
                    </static_file>
                    <stock_pending>
                        <table>page_cache_stock_pending</table>
                    </stock_pending>
                </entities>
            </page_cache_resource>
        </models>
        <blocks>
            <page_cache>
                <class>Maho_PageCache_Block</class>
            </page_cache>
        </blocks>
        <services>
            <page_cache>
                <class>Maho_PageCache_Service</class>
            </page_cache>
        </services>
        <cache>
            <types>
                <page_cache>
                    <label>Page Cache</label>
                    <description>HTTP page cache metadata, URL index and purge queue.</description>
                    <tags>PAGE_CACHE</tags>
                </page_cache>
            </types>
        </cache>
    </global>
    <adminhtml>
        <translate>
            <modules>
                <Maho_PageCache>
                    <files>
                        <default>Maho_PageCache.csv</default>
                    </files>
                </Maho_PageCache>
            </modules>
        </translate>
    </adminhtml>
    <default>
        <page_cache>
            <general>
                <enabled>0</enabled>
                <mode>revalidating</mode>
                <ttl>3600</ttl>
                <html_max_size>2097152</html_max_size>
                <cacheable_routes><![CDATA[cms_index_index
cms_page_view
catalog_category_view
catalog_product_view]]></cacheable_routes>
                <session_skip_routes><![CDATA[cms_index_index
cms_page_view
catalog_category_view
catalog_product_view]]></session_skip_routes>
                <allowed_params>p,limit,order,dir,mode</allowed_params>
                <filter_path_marker></filter_path_marker>
                <max_filter_depth>2</max_filter_depth>
                <max_path_segments>8</max_path_segments>
                <respect_no_cache>1</respect_no_cache>
                <debug_headers>0</debug_headers>
                <stock_pending_warn_age>3600</stock_pending_warn_age>
            </general>
            <local>
                <compression_enabled>1</compression_enabled>
                <compression_min_bytes>4096</compression_min_bytes>
                <compression_level>6</compression_level>
            </local>
            <proxy>
                <context_mode>cookie</context_mode>
            </proxy>
            <audit>
                <enabled>0</enabled>
                <retention_days>30</retention_days>
                <sample_tags>20</sample_tags>
            </audit>
            <purge>
                <max_attempts>5</max_attempts>
                <retry_delay>60</retry_delay>
                <stale_after>3600</stale_after>
                <retention_days>7</retention_days>
                <lease_seconds>300</lease_seconds>
            </purge>
            <dynamic>
                <injection>ajax</injection>
                <ttl>0</ttl>
                <server_side>0</server_side>
                <server_types></server_types>
                <rate_limit>120</rate_limit>
                <rate_limit_window>60</rate_limit_window>
            </dynamic>
            <warmup>
                <enabled>0</enabled>
                <concurrency>4</concurrency>
                <batch_size>50</batch_size>
                <delay_ms>500</delay_ms>
                <max_attempts>3</max_attempts>
                <retry_delay>300</retry_delay>
                <queue_limit>10000</queue_limit>
                <auth_user></auth_user>
                <auth_password></auth_password>
                <allowed_hosts></allowed_hosts>
            </warmup>
            <static>
                <enabled>0</enabled>
            </static>
            <stats>
                <enabled>0</enabled>
                <mode>full</mode>
                <sample_rate>0.05</sample_rate>
                <raw_retention_days>30</raw_retention_days>
                <rollup_retention_days>365</rollup_retention_days>
                <max_duration_ms>60000</max_duration_ms>
            </stats>
        </page_cache>
    </default>
</config>
